# ★ 大体积模型二进制（QNN EPContext 编译产物，不入库；构建时由脚本/HF 拉取）
app/src/normal/assets/qnn/*.bin
# ★ SAM 大模型（encoder 343MB / decoder 16MB，不入库；云编译从 zuimengqm/cpusam 拉取）
app/src/normal/assets/sam/*.onnx
# ★ Anime-Seg 大模型（176MB，不入库；云编译从 skytnt/anime-seg 拉取到 normal 专属 assets）
app/src/normal/assets/models/*.onnx

# ★ 签名私钥（务必保密，绝不入库）
